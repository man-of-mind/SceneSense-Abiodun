{
  "schema": "route_b_publication_instance_visibility_protocol_v1",
  "registered_date": "2026-08-31",
  "purpose": "Prospective held-out evaluation with renderer-derived per-actor instance visibility; no model selection or tuning.",
  "baseline_lock": "pole_lraspp_multimodal_fusion/object_head_pilot_v1/splitfusion_fcos_r50_fpn_p2_p7_service_candidate_v1/PERCEPTION_BASELINE_LOCK_V1.json",
  "primary_model": "SplitFusion-FCOS-R50-FPN-P2-P7 locked service candidate",
  "visibility": {
    "name": "renderer-derived in-frame instance visibility",
    "formula": "pixel_count(visible_instance_mask INTERSECT unoccluded_instance_mask) / pixel_count(unoccluded_instance_mask)",
    "visible_mask": "normal synchronized CARLA instance-segmentation rendering of the exact actor",
    "unoccluded_mask": "CARLA renderer instance mask of the same actor blueprint, pose and camera-relative transform with other scene actors and occluders absent",
    "denominator_scope": "in-frame unoccluded actor silhouette; off-image pixels are not counted as occlusion",
    "self_occlusion": "retained in both masks",
    "thresholds": [0.1, 0.25, 0.5, 0.7, 0.85],
    "forbidden_proxies": [
      "depth-consistent projected-box occupancy",
      "semantic-class pixels without instance identity",
      "filled 2D or 3D projected boxes",
      "ellipse or class-average silhouettes",
      "learned amodal completion"
    ]
  },
  "non_visibility_eligibility": {
    "source": "reuse the existing Route B v3 geometric qualification and 40 m range contract unchanged",
    "maximum_range_m": 40.0,
    "visibility_is_the_only_replaced_eligibility_signal": true
  },
  "prospective_episodes": [
