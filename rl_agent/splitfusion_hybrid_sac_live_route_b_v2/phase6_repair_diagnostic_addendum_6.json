  "id": "PHASE6_REPAIR_DIAGNOSTIC_ADDENDUM_6",
  "phase1_latency_boundary": {
    "implementation": "SensorFirstPlannerV2 in phase6_ue_runtime_v2; radar rasterization is timed (not reordered) by an instance-local build_radar_sample proxy and bound to the exact P40 window digest.",
    "order": [
      "radar_tensor_end",
      "sensor_prepared (submit entry, RGB converted)",
      "si_p40_start",
      "si_p40_end",
      "state_commit",
      "action_open",
      "input_7ch_start",
      "front_start",
      "front_end",
      "first_packet_send"
    ],
    "rule": "RUN4_CONTRACT.md: sensor preparation (RGB conversion, radar rasterization, camera SI, radar P40) completes and the causal state is committed before action-open; the actor decision, 7-channel construction, front, compression, uplink, tail, evaluation and feedback stay inside the unchanged 170-ms clock, never re-stamped.",
    "supersedes": "addendum-5 repair 1 (planning before radar rasterization)"
  },
  "phase2_e5": "E5 PASS requires >=1 successfully read identity-matched GT bundle, ready_wait_n > 0, every evaluator start <= 250 ms after GT ready, and zero reader exceptions, duplicate emissions and queue overflows; if no GT becomes ready it is INCONCLUSIVE_NO_GT_READY (gate false). E2 is the Phase-1 boundary on every frame.",
  "phase3_cycle_stop": "CycleBudgetV2: a new opportunity (decision or fallback) is admitted only if a full k_min group fits in the frame budget and the optional decision cap is not reached; holds are never refused. A refused opportunity assigns nothing (no actor call, no opportunity, no tensor) and stops the run as DECISION_CYCLE_BOUNDARY; the active ticket is drained (feedback, terminal or registered timeout) before accounting. Safety-timeout aborts remain aborts.",
  "phase4_gt_handoff": "Per component (objects.json, semantic.npy, semantic.json): UE host write (path, identity, time, size, SHA-256) via GtWriteRecorderV2; edge container view (path, first observed, size, SHA-256 at read, exact read errors); the complete edge GT scratch directory preserved create-only with a verified manifest before the temporary source is deleted; actual bind mounts from edge_image_launch.json.",
  "phase5_handshake": {
    "ceiling": "at most 40 transmitted frames and 60 s of route time; not extended, no retry",
    "command_args": [
      "--transmitted-budget",
      "40",
      "--stop-after-decisions",
      "1",
      "--safety-timeout-s",
      "60",
      "--child-timeout-s",
      "600"
    ],
    "pass_requires": [
      "all three GT components exist and match in host and container views",
      "read_ground_truth succeeds before the local 2-s GT expiry",
      "GT-ready and evaluator-start timestamps exist",
      "evaluator wait <= 250 ms",
      "feedback crosses the UE downlink (P7) and is ACCEPTED, not GROUND_TRUTH_UNAVAILABLE/UNKNOWN_ORPHAN/CONFLICT/LATE_ORPHAN",
      "the decision has >=2 tensors and exactly one reward request",
      "zero unresolved tickets",
      "actor/checkpoint hashes unchanged",
      "cold host and initial channel state restored"
    ]
  },
  "phase6_conditional_30": {
    "after": "STOP regardless of outcome; no 120- or 300-frame run",
    "command_args": [
      "--transmitted-budget",
      "30",
      "--safety-timeout-s",
      "120"
