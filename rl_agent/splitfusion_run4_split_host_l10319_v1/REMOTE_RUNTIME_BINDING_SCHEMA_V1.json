{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenesense.run4.remote_runtime_binding.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hostname", "host_ipv4", "gpu", "image_tag", "image_manifest_digest", "image_config_digest", "remote_image_id", "remote_container_image_id", "canonical_inspect_fields_sha256", "artifacts"],
  "properties": {
    "schema": {"const": "scenesense.run4.remote_runtime_binding.v1"},
    "hostname": {"const": "L10319"},
    "host_ipv4": {"const": "10.21.16.162"},
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "uuid", "memory_total_mib", "driver_version"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "uuid": {"type": "string", "minLength": 1},
        "memory_total_mib": {"type": "integer", "minimum": 1},
        "driver_version": {"type": "string", "minLength": 1}
      }
    },
    "image_tag": {"const": "oai-perception-rx:latest"},
    "image_manifest_digest": {"const": "sha256:ac1437601cb1b4a52c761d762ba533fcb431e46f364073516697a89155cd901c"},
    "image_config_digest": {"const": "sha256:2be62d533b8077ceecab5455d5377f2f952b6a50d43ff8c04dc89ce18027d6ba"},
    "remote_image_id": {"const": "sha256:ac1437601cb1b4a52c761d762ba533fcb431e46f364073516697a89155cd901c"},
    "remote_container_image_id": {"const": "sha256:ac1437601cb1b4a52c761d762ba533fcb431e46f364073516697a89155cd901c"},
    "canonical_inspect_fields_sha256": {"const": "c5a6690923255163ccb090db0c6f278b1761e4c52e516f024ba88c970ee918d1"},
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "relative_path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
