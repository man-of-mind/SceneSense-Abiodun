digraph AgentTimeline {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.55", fontname="DejaVu Sans", labelloc="t", label="9-FPS tail-only control with delayed, identity-safe PPO feedback"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#40566f", penwidth=1.3, margin="0.10,0.07"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#40566f", penwidth=1.2];

  f1 [label="Frame f1 sensor compute complete\ncausal SNR / MCS / BSR", fillcolor="#eaf1ff"];
  lstm1 [label="Encoder + LSTM\n(h0,c0) -> (h1,c1)", fillcolor="#fdebf0"];
  forecast [label="Forecast next 100-ms radio window\nmean + uncertainty", fillcolor="#f2eefc"];
  a1 [label="PPO action a1\n72-way SPLIT policy", fillcolor="#ecf8f5"];
  p1 [label="OPEN pending ticket\n(session, UE, f1, a1)", fillcolor="#fff4d6"];
  radio1 [label="Feature uplink\nOAI / RFsim", fillcolor="#eaf1ff"];
  edge1 [label="Edge latest-only slot\nreconstruct + model tail", fillcolor="#f2eefc"];
  wire [label="Wire TAIL_COMPLETED_ACK\nidentity + edge event\nquality provenance + actual costs", fillcolor="#fff4d6", color="#d18b00", penwidth=2.0];
  stamp [label="UE stamps ACK receipt\nderives latency + 140-ms result", fillcolor="#fff4d6"];
  close [label="CLOSE exact f1 ticket\nkeep any latched miss", fillcolor="#fff4d6"];

  post [label="Post-process + filter\ndirect object-map update", fillcolor="#f2eefc"];
  map1 [label="MAP_OUTCOME audit\nnot PPO tail_only_v1", fillcolor="#ecf8f5"];

  miss [label="At 140 ms if no terminal event:\nDEADLINE_MISSED_PENDING\nservice miss, not radio loss", fillcolor="#fce8e6", color="#c44e52", penwidth=2.0];
  f2 [label="Next frame period = 111.1 ms\nf2 action cutoff about 141.1 ms", fillcolor="#eaf1ff"];
  drain [label="Drain only events received\nby the f2 decision cutoff", fillcolor="#fff4d6"];
  pending [label="If f1 ACK absent:\nf1 remains PENDING\nnot inferred LOST", fillcolor="#fff4d6", color="#d18b00", penwidth=2.0];
  lstm2 [label="Observe tail-frame lag\npending age/count + terminal history\nLSTM chooses a2", fillcolor="#fdebf0"];
  a2 [label="OPEN ticket f2,a2\nand continue", fillcolor="#ecf8f5"];
  horizon [label="After every ticket through\nfixed rollout horizon reconciles:\nGAE + PPO update", fillcolor="#ecf8f5"];

  f1 -> lstm1 -> a1 -> p1 -> radio1 -> edge1;
  lstm1 -> forecast [style=dashed, label="causal prediction"];
  forecast -> a1 [style=dashed, color="#54a24b", label="stored detached policy input"];
  edge1 -> wire -> stamp -> close;
  edge1 -> post -> map1 [style=dashed, label="independent audit path"];

  p1 -> miss [style=dashed, color="#c44e52", label="only if unresolved at deadline"];
  f1 -> f2 [style=dotted, label="111.1-ms frame epoch", constraint=false];
  miss -> f2 [style=dashed, color="#c44e52", label="visible before cutoff"];
  f2 -> drain;
  close -> drain [style=dashed, label="if ACK arrived by cutoff"];
  drain -> pending [style=dashed, label="otherwise"];
  drain -> lstm2 [label="received outcomes"];
  pending -> lstm2 [label="pending state"];
  lstm2 -> a2;
  close -> horizon [style=dashed, label="ordered reconciliation"];
}
