{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenesense://schemas/perception_episode_v1.schema.json",
  "title": "Full-route perception episode manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "episode_id",
    "status",
    "seed",
    "density_profile",
    "scenario_id",
    "weather",
    "route_id",
    "route_sha256",
    "route_regions",
    "laps_completed",
    "frame_count",
    "frame_manifest_path",
    "frame_manifest_sha256",
    "sensor_identifiers",
    "owned_actor_cleanup",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "scenesense.perception_episode.v1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "COMPLETE"
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_bundle_id",
        "carla_seed",
        "traffic_manager_seed"
      ],
      "properties": {
        "seed_bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "carla_seed": {
          "type": "integer"
        },
        "traffic_manager_seed": {
          "type": "integer"
        }
      }
    },
    "density_profile": {
      "enum": [
        "low",
        "medium",
        "dense"
      ]
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "weather": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "route_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "route_regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "laps_completed": {
      "type": "integer",
      "minimum": 1
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "frame_manifest_path": {
      "$ref": "#/$defs/relative_path"
    },
    "frame_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sensor_identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owned_actor_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spawned_actor_ids",
        "destroyed_actor_ids",
        "remaining_owned_actor_ids",
        "completed"
      ],
      "properties": {
        "spawned_actor_ids": {
          "$ref": "#/$defs/actor_ids"
        },
        "destroyed_actor_ids": {
          "$ref": "#/$defs/actor_ids"
        },
        "remaining_owned_actor_ids": {
          "type": "array",
          "maxItems": 0
        },
        "completed": {
          "const": true
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "all_artifacts_verified",
        "episode_manifest_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "all_artifacts_verified": {
          "const": true
        },
        "episode_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "actor_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
